@page "/dashboard"
@inject JournalService JournalService

<h3>📊 Journal Streak Dashboard</h3>

<div class="card p-3 mb-3">
    <h5>🔥 Current Streak</h5>
    <p class="fs-4">@CurrentStreak days</p>
</div>

<div class="card p-3 mb-3">
    <h5>🏆 Longest Streak</h5>
    <p class="fs-4">@LongestStreak days</p>
</div>

<div class="card p-3 mb-3">
    <h5>❌ Missed Days</h5>

    @if (!MissedDays.Any())
    {
        <p>No missed days 🎉</p>
    }
    else
    {
        <ul>
            @foreach (var day in MissedDays)
            {
                <li>@day.ToString("dd MMM yyyy")</li>
            }
        </ul>
    }
</div>

@code {
    int CurrentStreak;
    int LongestStreak;
    List<DateTime> MissedDays = new();

    protected override void OnInitialized()
    {
        CurrentStreak = JournalService.GetCurrentStreak();
        LongestStreak = JournalService.GetLongestStreak();
        MissedDays = JournalService.GetMissedDays();
    }
}
