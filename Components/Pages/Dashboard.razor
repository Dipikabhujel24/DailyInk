@page "/dashboard"
@inject JournalService JournalService

<div class="content-center">

    <h2 class="mb-4">📊 Dashboard Insights</h2>

    <!-- STREAKS -->
    <div class="card p-3 mb-4">
        <h5>🔥 Writing Streaks</h5>
        <p>Current Streak: <strong>@CurrentStreak</strong> days</p>
        <p>Longest Streak: <strong>@LongestStreak</strong> days</p>
    </div>

    <!-- MISSED DAYS -->
    <div class="card p-3 mb-4">
        <h5>❌ Missed Days</h5>

        @if (MissedDays.Any())
        {
            <ul class="list-group">
                @foreach (var day in MissedDays)
                {
                    <li class="list-group-item text-danger">
                        @day.ToString("dddd, dd MMM yyyy")
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-success">No missed days 🎉</p>
        }
    </div>

    <!-- PRIMARY MOODS -->
    <div class="card p-3 mb-4">
        <h5>😊 Primary Mood Distribution</h5>

        @if (PrimaryMoods.Any())
        {
            <ul>
                @foreach (var item in PrimaryMoods)
                {
                    <li>@item.Key — <strong>@item.Value</strong></li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No data yet</p>
        }
    </div>

    <!-- SECONDARY MOODS -->
    <div class="card p-3 mb-4">
        <h5>✨ Frequent Secondary Moods</h5>

        @if (SecondaryMoods.Any())
        {
            <ul>
                @foreach (var item in SecondaryMoods)
                {
                    <li>@item.Key — <strong>@item.Value</strong></li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No data yet</p>
        }
    </div>

    <!-- TAGS -->
    <div class="card p-3 mb-4">
        <h5>🏷 Most Used Tags</h5>

        @if (Tags.Any())
        {
            <ul>
                @foreach (var item in Tags)
                {
                    <li>@item.Key — <strong>@item.Value</strong></li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No tags yet</p>
        }
    </div>

    <!-- WORD COUNT -->
    <div class="card p-3 mb-4">
        <h5>📝 Word Count by Day</h5>

        @if (WordCounts.Any())
        {
            <ul>
                @foreach (var item in WordCounts.OrderBy(d => d.Key))
                {
                    <li>
                        @item.Key.ToString("dd MMM yyyy") —
                        <strong>@item.Value</strong> words
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No entries yet</p>
        }
    </div>

</div>

@code {
    int CurrentStreak;
    int LongestStreak;

    List<DateTime> MissedDays = new();

    Dictionary<string, int> PrimaryMoods = new();
    Dictionary<string, int> SecondaryMoods = new();
    Dictionary<string, int> Tags = new();
    Dictionary<DateTime, int> WordCounts = new();

    protected override void OnInitialized()
    {
        CurrentStreak = JournalService.GetCurrentStreak();
        LongestStreak = JournalService.GetLongestStreak();

        MissedDays = JournalService.GetMissedDays();

        PrimaryMoods = JournalService.GetPrimaryMoodDistribution();
        SecondaryMoods = JournalService.GetSecondaryMoodDistribution();
        Tags = JournalService.GetTagUsage();
        WordCounts = JournalService.GetWordCountByDate();
    }
}
