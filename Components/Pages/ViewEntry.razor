@page "/view/{EntryId:int}"
@inject JournalService JournalService
@inject NavigationManager Nav


<button class="btn btn-link mb-3"
        @onclick="GoBack"
        style="text-decoration:none; font-size:1.1rem;">
    ← Back to Entries
</button>

@if (entry == null)
{
    <p>Entry not found.</p>
}
else
{
    <h3>@entry.Title</h3>
    <p class="text-muted">
        @entry.EntryDate.ToString("dddd, dd MMMM yyyy")
    </p>

    <p><strong>Primary Mood:</strong> @entry.PrimaryMood</p>

    @if (entry.SecondaryMoods.Any())
    {
        <p>
            <strong>Secondary Moods:</strong>
            @string.Join(", ", entry.SecondaryMoods)
        </p>
    }

    <hr />

    <p>@entry.Content</p>
}

@code {
    [Parameter]
    public int EntryId { get; set; }

    JournalEntry? entry;

    protected override void OnInitialized()
    {
        entry = JournalService
            .GetAllEntries()
            .FirstOrDefault(e => e.EntryId == EntryId);
    }

    void GoBack()
{
    Nav.NavigateTo("/paginate");
}

}
