@page "/search"
@using DailyInk.Models

@inject JournalService JournalService
@inject NavigationManager NavigationManager

<div class="content-center">

    <h3 class="mb-4">🔍 Search & Filter Journals</h3>

    <!-- FILTER CARD -->
    <div class="card p-4 mb-4">
        <input class="form-control mb-3"
               placeholder="Search by title or content"
               @bind="keyword" />

        <div class="row mb-3">
            <div class="col">
                <label class="form-label">From</label>
                <input type="date" class="form-control" @bind="fromDate" />
            </div>

            <div class="col">
                <label class="form-label">To</label>
                <input type="date" class="form-control" @bind="toDate" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Primary Mood</label>
            <select class="form-select" @bind="mood">
                <option value="">All</option>
                @foreach (var m in moods)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Tag</label>
            <input class="form-control"
                   placeholder="e.g. Work, Health"
                   @bind="tag" />
        </div>

        <button class="btn btn-primary w-100" @onclick="ApplyFilters">
            Apply Filters
        </button>
    </div>

    <!-- RESULTS -->
    @if (results.Any())
    {
        <ul class="list-group">
            @foreach (var entry in results)
            {
                <li class="list-group-item list-group-item-action"
                    style="cursor:pointer"
                    @onclick="() => Open(entry.EntryId)">
                    <strong>@entry.Title</strong><br />
                    <small class="text-muted">
                        @entry.EntryDate.ToString("dd MMM yyyy")
                        • Mood: @entry.PrimaryMood
                    </small>
                </li>
            }
        </ul>
    }
    else if (searched)
    {
        <p class="text-muted text-center mt-3">
            No matching entries found.
        </p>
    }

</div>

@code {
    string keyword = "";
    DateTime? fromDate;
    DateTime? toDate;
    string? mood;
    string? tag;

    bool searched = false;
    List<JournalEntry> results = new();

    List<string> moods = new()
    {
        "Happy", "Sad", "Calm", "Angry", "Anxious", "Excited"
    };

    void ApplyFilters()
    {
        searched = true;

        results = JournalService.SearchAndFilter(
            keyword,
            fromDate,
            toDate,
            mood,
            tag);
    }

    void Open(int id)
    {
        NavigationManager.NavigateTo($"/view/{id}");
    }
}
