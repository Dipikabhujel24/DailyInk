@page "/journal"

@using DailyInk.Models
@using Microsoft.JSInterop

@inject JournalService JournalService
@inject SecurityService SecurityService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="content-center">

    <h3>📝 Daily Journal</h3>
    <p class="text-muted">@DateTime.Now.ToString("dddd, MMMM dd yyyy")</p>

    <!-- TITLE -->
    <div class="card p-3 mb-3">
        <h5>Title</h5>
        <input class="form-control"
               placeholder="Enter a title for today..."
               @bind="Entry.Title" />
    </div>

    <!-- PRIMARY MOOD -->
    <div class="card p-3 mb-3">
        <h5>Primary Mood <span class="text-danger">*</span></h5>

        <div class="mood-row">
            @foreach (var mood in Moods)
            {
                <div class="mood-card @(Entry.PrimaryMood == mood.Name ? "selected" : "")"
                     @onclick="() => Entry.PrimaryMood = mood.Name">
                    <div class="emoji">@mood.Emoji</div>
                    <div class="label">@mood.Name</div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(primaryMoodError))
        {
            <div class="text-danger mt-2">@primaryMoodError</div>
        }
    </div>

    <!-- SECONDARY MOODS -->
    <div class="card p-3 mb-3">
        <h5>Secondary Moods <small class="text-muted">(max 2)</small></h5>

        <div class="d-flex gap-2 mb-2">
            <input class="form-control"
                   placeholder="Type a mood (e.g. tired, hopeful)"
                   @bind="SecondaryMoodInput"
                   @bind:event="oninput"
                   disabled="@(Entry.SecondaryMoods.Count >= 2)" />

            <button class="btn btn-outline-primary"
                    @onclick="AddSecondaryMood"
                    disabled="@(Entry.SecondaryMoods.Count >= 2 || string.IsNullOrWhiteSpace(SecondaryMoodInput))">
                Add
            </button>
        </div>

        <div class="secondary-mood-chip-container">
            @foreach (var mood in Entry.SecondaryMoods)
            {
                <span class="secondary-mood-chip">
                    @mood
                    <button class="remove-btn"
                            @onclick="() => RemoveSecondaryMood(mood)">
                        ✕
                    </button>
                </span>
            }
        </div>
    </div>

    <!-- RICH TEXT EDITOR -->
    <div class="card p-3 mb-4">
        <h5>Your Thoughts</h5>

        <!-- TOOLBAR -->
        <div class="btn-group mb-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Exec("bold")'><b>B</b></button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Exec("italic")'><i>I</i></button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Exec("insertUnorderedList")'>•</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Exec("formatBlock", "h2")'>H</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="InsertLink">🔗</button>
        </div>

        <!-- EDITOR -->
        <div class="form-control rich-editor"
             contenteditable="true"
             @ref="editorRef"
             style="min-height:220px; white-space:pre-wrap;"
             @oninput="SyncPreview">
        </div>
    </div>

    <!-- PREVIEW -->
    <div class="mb-4">
        <h6>Preview</h6>
        <div class="card p-3 preview-box">
            @((MarkupString)Entry.Content)
        </div>
    </div>

    <!-- TAGS -->
    <div class="card p-3 mb-4">
        <h5>Tags</h5>
        <input class="form-control"
               placeholder="e.g. Work, Health, Travel"
               @bind="Entry.Tags" />
    </div>

    <!-- ACTION BUTTONS -->
    <div class="mb-5">
        <button class="btn btn-success me-2" disabled="@(!IsNew)" @onclick="SaveEntry">Save</button>
        <button class="btn btn-primary me-2" disabled="@(IsNew)" @onclick="UpdateEntry">Update</button>
        <button class="btn btn-danger" disabled="@(IsNew)" @onclick="Delete">Delete</button>
    </div>

</div>

@code {
    JournalEntry Entry = new();
    bool IsNew = true;

    string? primaryMoodError;
    string SecondaryMoodInput = "";

    ElementReference editorRef;

    List<MoodOption> Moods = new()
    {
        new() { Name = "Happy", Emoji = "😊" },
        new() { Name = "Sad", Emoji = "😔" },
        new() { Name = "Calm", Emoji = "😌" },
        new() { Name = "Angry", Emoji = "😠" },
        new() { Name = "Anxious", Emoji = "😟" },
        new() { Name = "Excited", Emoji = "🤩" }
    };

    protected override void OnInitialized()
    {
        if (!SecurityService.IsPinSet)
        {
            Nav.NavigateTo("/set-pin", true);
            return;
        }

        if (!SecurityService.IsUnlocked)
        {
            Nav.NavigateTo("/lock", true);
            return;
        }

        Load();
    }

    void Load()
    {
        var today = JournalService.GetTodayEntry();
        if (today != null)
        {
            Entry = today;
            _ = Entry.SecondaryMoods;
            IsNew = false;
        }
        else
        {
            Entry = new JournalEntry();
            IsNew = true;
        }
    }

    async Task SyncPreview()
    {
        Entry.Content = await JS.InvokeAsync<string>("getHtml", editorRef);
        StateHasChanged();
    }


    async Task Exec(string command, string? value = null)
    {
        await JS.InvokeVoidAsync("execCmd", command, value);
        await SyncPreview();
    }

    async Task InsertLink()
    {
        var url = await JS.InvokeAsync<string>("prompt", "Enter URL");
        if (!string.IsNullOrWhiteSpace(url))
        {
            await Exec("createLink", url);
        }
    }

    void AddSecondaryMood()
    {
        var mood = SecondaryMoodInput.Trim();
        if (Entry.SecondaryMoods.Count < 2 &&
            !Entry.SecondaryMoods.Contains(mood, StringComparer.OrdinalIgnoreCase))
        {
            Entry.SecondaryMoods.Add(mood);
            SecondaryMoodInput = "";
        }
    }

    void RemoveSecondaryMood(string mood)
        => Entry.SecondaryMoods.Remove(mood);

    void SaveEntry()
    {
        primaryMoodError = null;

        if (string.IsNullOrWhiteSpace(Entry.PrimaryMood))
        {
            primaryMoodError = "Primary mood is required.";
            return;
        }

        Entry.SecondaryMoodsRaw = string.Join(",", Entry.SecondaryMoods);
        JournalService.SaveTodayEntry(Entry);
        Load();
    }

    void UpdateEntry() => SaveEntry();

    void Delete()
    {
        JournalService.DeleteTodayEntry();
        Load();
    }
}
