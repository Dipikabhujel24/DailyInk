@page "/journal"

@inject JournalService JournalService
@inject MarkdownService MarkdownService

<h3>📝 Daily Journal</h3>
<p class="text-muted">@DateTime.Now.ToString("dddd, MMMM dd yyyy")</p>

<!-- TITLE -->
<div class="card p-3 mb-3">
    <h5>Title</h5>
    <input class="form-control"
           placeholder="Enter a title for today..."
           @bind="Entry.Title" />
</div>

<!-- PRIMARY MOOD -->
<div class="card p-3 mb-3">
    <h5>Primary Mood <span class="text-danger">*</span></h5>

    <div class="mood-row">
        @foreach (var mood in Moods)
        {
            <div class="mood-card @(Entry.PrimaryMood == mood.Name ? "selected" : "")"
                 @onclick="() => Entry.PrimaryMood = mood.Name">
                <div class="emoji">@mood.Emoji</div>
                <div class="label">@mood.Name</div>
            </div>
        }
    </div>

    @if (primaryMoodError != null)
    {
        <div class="text-danger mt-2">@primaryMoodError</div>
    }
</div>

<!-- SECONDARY MOODS -->
<div class="card p-3 mb-3">
    <h5>Secondary Moods (max 2)</h5>

    <div class="mood-chip-container">
        @foreach (var mood in Moods)
        {
            <span class="mood-chip @(Entry.SecondaryMoods.Contains(mood.Name) ? "active" : "")"
                  @onclick="() => ToggleSecondary(mood.Name)">
                @mood.Emoji @mood.Name
            </span>
        }
    </div>

    @if (secondaryMoodError != null)
    {
        <div class="text-danger mt-2">@secondaryMoodError</div>
    }
</div>

<!-- MARKDOWN CONTENT -->
<div class="card p-3 mb-3">
    <h5>Your Thoughts (Markdown Supported)</h5>

    <textarea class="form-control mb-3"
              rows="8"
              placeholder="Write using Markdown..."
              @bind="Entry.Content">
    </textarea>

    <h6>Preview</h6>
    <div class="border p-3 markdown-preview">
        @((MarkupString)MarkdownService.ToHtml(Entry.Content))
    </div>
</div>

<!-- TAGS -->
<div class="card p-3 mb-3">
    <h5>Tags</h5>
    <input class="form-control"
           placeholder="e.g. Work, Health, Travel"
           @bind="Entry.Tags" />
</div>

<!-- ACTION BUTTONS -->
<div class="mt-3">

    <!-- SAVE BUTTON -->
    <button class="btn btn-success me-2"
            disabled="@(!IsNew)"
            @onclick="SaveEntry">
        Save
    </button>

    <!-- UPDATE BUTTON -->
    <button class="btn btn-primary me-2"
            disabled="@(IsNew)"
            @onclick="UpdateEntry">
        Update
    </button>

    <!-- DELETE BUTTON -->
    <button class="btn btn-danger"
            disabled="@(IsNew)"
            @onclick="Delete">
        Delete
    </button>

</div>


@code {
    JournalEntry Entry = new();
    bool IsNew = true;

    string? primaryMoodError;
    string? secondaryMoodError;

    List<MoodOption> Moods = new()
    {
        new() { Name = "Happy", Emoji = "😊" },
        new() { Name = "Sad", Emoji = "😔" },
        new() { Name = "Calm", Emoji = "😌" },
        new() { Name = "Angry", Emoji = "😠" },
        new() { Name = "Anxious", Emoji = "😟" },
        new() { Name = "Excited", Emoji = "🤩" }
    };

    protected override void OnInitialized()
    {
        Load();
    }

    void Load()
    {
        var todayEntry = JournalService.GetTodayEntry();

        if (todayEntry != null)
        {
            Entry = todayEntry;

            _ = Entry.SecondaryMoods;

            IsNew = false;
        }
        else
        {
            Entry = new JournalEntry();
            IsNew = true;
        }
    }


    void ToggleSecondary(string mood)
    {
        secondaryMoodError = null;

        if (Entry.SecondaryMoods.Contains(mood))
        {
            Entry.SecondaryMoods.Remove(mood);
        }
        else
        {
            if (Entry.SecondaryMoods.Count >= 2)
            {
                secondaryMoodError = "You can select up to 2 secondary moods only.";
                return;
            }

            Entry.SecondaryMoods.Add(mood);
        }

        StateHasChanged();
    }


    void SaveEntry()
    {
        primaryMoodError = null;

        if (string.IsNullOrWhiteSpace(Entry.PrimaryMood))
        {
            primaryMoodError = "Please select a primary mood.";
            return;
        }

        Entry.SecondaryMoodsRaw = string.Join(",", Entry.SecondaryMoods);

        JournalService.SaveTodayEntry(Entry);
        Load();
    }


    void UpdateEntry()
    {
        primaryMoodError = null;

        if (string.IsNullOrWhiteSpace(Entry.PrimaryMood))
        {
            primaryMoodError = "Please select a primary mood.";
            return;
        }

        Entry.SecondaryMoodsRaw = string.Join(",", Entry.SecondaryMoods);

        JournalService.SaveTodayEntry(Entry);
        Load();
    }


    void Delete()
    {
        JournalService.DeleteTodayEntry();
        Load();
    }
}
