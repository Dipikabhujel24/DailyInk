@page "/lock"
@inject SecurityService SecurityService
@inject NavigationManager Nav

<div class="content-center">
    <div class="card p-4" style="max-width:400px;margin:auto;">
        <h4>Enter PIN</h4>

        <input type="password" class="form-control mb-3" @bind="pin" />

        <button class="btn btn-primary w-100" @onclick="Unlock">Unlock</button>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="text-danger mt-2">@error</div>
        }
    </div>
</div>

@code {
    string pin = "";
    string? error;

    void Unlock()
    {
        if (SecurityService.ValidatePin(pin))
            Nav.NavigateTo("/", true);
        else
            error = "Incorrect PIN";
    }
}
