@page "/entries"
@inject JournalService JournalService

<h3>📚 Past Journal Entries</h3>

<ul class="list-group">
    @foreach (var entry in entries)
    {
        <li class="list-group-item"
            @onclick="() => Open(entry.EntryId)"
            style="cursor:pointer">

            <strong>@entry.Title</strong><br />
            <small>@entry.EntryDate.ToString("dd MMM yyyy")</small>
        </li>
    }
</ul>

@code {
    List<JournalEntry> entries = new();

    protected override void OnInitialized()
    {
        entries = JournalService.GetAllEntries();
    }

    void Open(int id)
    {
        NavigationManager.NavigateTo($"/view/{id}");
    }

    [Inject]
    NavigationManager NavigationManager { get; set; } = default!;
}
